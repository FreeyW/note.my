# note.my — Nginx site config.
#
# Security headers live here rather than in PHP so they also cover static
# assets and error pages that never reach the application.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name note.my;

    root /srv/note.my/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/note.my/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/note.my/privkey.pem;

    client_max_body_size 128k;   # well above the 32 KB payload cap

    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Permissions-Policy "interest-cohort=(), geolocation=(), camera=(), microphone=()" always;

    # Assets are content-hashed, so they can be cached hard and forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # No access logging on note paths. A log line pairing a timestamp with
    # /n/{id} would reconstruct exactly the metadata this service exists to
    # avoid keeping — and would outlive the note itself.
    location /n/ {
        access_log off;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.php$is_args$args;
    }

    location /api/ {
        access_log off;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.php$is_args$args;
    }

    # robots.txt and sitemap.xml are generated by PHP so they inherit
    # canonical_origin from config rather than being duplicated on disk.
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;

        # Only index.php is a valid entry point. Without this a stray .php file
        # anywhere under the root becomes executable.
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    }

    # Nothing outside public/ is reachable, but be explicit about dotfiles.
    location ~ /\. {
        deny all;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name note.my;
    return 301 https://$host$request_uri;
}
